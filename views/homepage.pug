doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        main
            a(href="/update-cobj") Add to this table
            h1 Mini Dachshunds
            table
                thead
                    tr
                        th Name
                        th Color
                        th Personality
                tbody
                    each record in data
                        tr
                            td= record.properties.dachshund_name
                            td= record.properties.color
                            td= record.properties.personality
