doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        .form-wrapper
            h1 Add a Mini Dachshund
            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input(type="text" id="name" name="name" required)
                label(for="color") Color
                input(type="text" id="color" name="color" required)
                label(for="personality") Personality
                input(type="text" id="personality" name="personality" required)
                input(type="submit" value="Add Mini Dachshund")
            p
                a(href="/") Return to the homepage
